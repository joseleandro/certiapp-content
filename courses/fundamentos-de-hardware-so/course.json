    "choices": [
     {
      "id": "a",
      "text": {
       "pt": "Memória RAM"
      }
     },
     {
      "id": "b",
      "text": {
       "pt": "CPU"
      }
     },
     {
      "id": "c",
      "text": {
       "pt": "SSD"
      }
     },
     {
      "id": "d",
      "text": {
       "pt": "Fonte de alimentação"
      }
     }
    ],
    "correct": "b",
    "explanation": {
     "pt": "A CPU busca, decodifica e executa instruções. A RAM e o SSD só guardam dados."
    }
